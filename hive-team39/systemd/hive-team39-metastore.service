[Unit]
Description=Hive team-39 standalone Metastore (PostgreSQL)
Wants=network-online.target
After=network-online.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=hive
Group=hive
WorkingDirectory=/var/lib/hive-team39
EnvironmentFile=/etc/hive-team39/service.env
Environment=HIVE_CONF_DIR=/etc/hive-team39/metastore
Environment=HADOOP_HEAPSIZE=512
Environment="HADOOP_CLIENT_OPTS=-Dhive.log.dir=/var/log/hive-team39 -Dhive.log.file=metastore.log"
ExecStart=/opt/hive/bin/hive --service metastore -p 9083
Restart=on-failure
RestartSec=5
TimeoutStopSec=60
LimitNOFILE=65536
UMask=0027

[Install]
WantedBy=multi-user.target
