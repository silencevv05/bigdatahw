[Unit]
Description=MapReduce JobHistory Server (team-39)
Wants=network-online.target
After=network-online.target yarn-resourcemanager.service

[Service]
Type=simple
User=mapred
Group=mapred
Environment=JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
Environment=HADOOP_HOME=/opt/hadoop
Environment=HADOOP_MAPRED_HOME=/opt/hadoop
Environment=HADOOP_CONF_DIR=/opt/hadoop/etc/hadoop
Environment=HADOOP_LOG_DIR=/var/log/mapred
Environment=HADOOP_MAPRED_LOG_DIR=/var/log/mapred
Environment=HADOOP_MAPRED_HISTORYSERVER_HEAPSIZE=512
ExecStart=/opt/hadoop/bin/mapred historyserver
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
